# ─────────────────────────────────────────────────────────────────────────────
# Website Grader — environment
# Copy to .env.local and fill in what you need. NOTHING here is required to run
# the app locally: with no keys set it boots in demo mode with a dev auth bypass.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local dev: run keyless ───────────────────────────────────────────────────
# In development the app skips Google sign-in by default (keyless out of the
# box). To test real sign-in locally, set BOTH of these to "false". The bypass
# can never be active in a production build (NODE_ENV gate).
# DEV_NO_AUTH=false
# NEXT_PUBLIC_DEV_NO_AUTH=false

# Force the deterministic sample scorecard even if ANTHROPIC_API_KEY is set.
# Leave unset for real scoring; the app also auto-enables demo mode when no key.
# DEMO_MODE=true

# ── Hosted public demo ───────────────────────────────────────────────────────
# Deploy a keyless, sign-in-free demo (sample scores) to a public host.
# Set BOTH, add no Anthropic key, and the deployed site runs in demo mode.
# Leave unset on a real production deploy — sign-in stays required.
# PUBLIC_DEMO=true
# NEXT_PUBLIC_PUBLIC_DEMO=true

# ── Scoring (real analysis) ──────────────────────────────────────────────────
# Without this, the app returns a sample score (demo mode).
ANTHROPIC_API_KEY=

# Optional fallback used only if Anthropic returns a billing/credit error.
XAI_API_KEY=

# ── Submissions → Google Sheets ──────────────────────────────────────────────
# Google Apps Script Web App deploy URL. Each graded site appends one row.
# Setup steps: see README ("Log submissions to Google Sheets"). Unset = no-op.
GOOGLE_SHEETS_WEBHOOK_URL=

# ── Google sign-in (production) ──────────────────────────────────────────────
# Required in production (not needed when DEV_NO_AUTH=true locally).
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional enhancements ────────────────────────────────────────────────────
# Cleaner page extraction (homepage + pricing). Falls back to a built-in scraper.
FIRECRAWL_API_KEY=
# Extra URL-safety layer (Google Web Risk). Safety still runs without it.
GOOGLE_WEB_RISK_API_KEY=
# Email funnel sync (Loops). No-op when unset.
LOOPS_API_KEY=
